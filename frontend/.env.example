# MongoDB Atlas connection string (free M0 cluster)
#MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thekashmirtravels?retryWrites=true&w=majority

# Cloudinary (free tier) — Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Request emails (booking + custom trip) via Gmail SMTP.
# GMAIL_USER: the Gmail account that sends. GMAIL_APP_PASSWORD: 16-character App Password (not your login password).
# REQUEST_TO_EMAIL: where requests are delivered (defaults to GMAIL_USER).


#GMAIL_USER=yourgmail@gmail.com
#GMAIL_APP_PASSWORD=<16-character app password, no spaces>
#REQUEST_TO_EMAIL=where-you-want-leads@gmail.com

# DEMO MODE — local development only. Runs the site and admin without MongoDB,
# Cloudinary or Gmail, using in-memory sample data (resets on restart).
# Only active when MONGODB_URI is unset. It is IGNORED when NODE_ENV=production
# or on Vercel — never rely on it (or set it) in a deployed environment.
# Demo admin login: demo@admin.local / demo1234
#DEMO_MODE=true

DEMO_MODE=true
