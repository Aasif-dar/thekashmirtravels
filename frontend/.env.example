# Copy to .env.local (git-ignored) and fill in. Every variable below is read on
# the server only — never prefix any of them with NEXT_PUBLIC_.

# MongoDB Atlas connection string. The database name in the path is where the
# app creates its collections (destinations, journeys, requests, admins).
MONGODB_URI=

# Signs the admin login cookie. 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cloudinary — admin image uploads (Dashboard > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Booking / trip-request emails via Gmail SMTP.
# GMAIL_APP_PASSWORD is a 16-character App Password, not your login password.
# REQUEST_TO_EMAIL is where requests are delivered (defaults to GMAIL_USER).
GMAIL_USER=
GMAIL_APP_PASSWORD=
REQUEST_TO_EMAIL=

# Optional, local development only: run the admin with no database, uploads or
# email (empty in-memory store). Ignored when MONGODB_URI is set, when
# NODE_ENV=production, and on Vercel. Never set it on a deployed environment.
#DEMO_MODE=true
